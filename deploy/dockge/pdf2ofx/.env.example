# PDF2OFX Platform — implantação Docker/GHCR
COMPOSE_PROJECT_NAME=pdf2ofx
PDF2OFX_VERSION=1.2.0
GHCR_NAMESPACE=wkarts

APP_IMAGE=ghcr.io/wkarts/pdf2ofx-app:1.2.0
GATEWAY_IMAGE=ghcr.io/wkarts/pdf2ofx-gateway:1.2.0
CONVERTER_IMAGE=ghcr.io/wkarts/pdf2ofx-converter:1.2.0
REDIS_IMAGE=ghcr.io/wkarts/pdf2ofx-base-redis:8-alpine
POSTGRES_IMAGE=ghcr.io/wkarts/pdf2ofx-base-postgres:17-alpine

APP_NAME=PDF2OFX
APP_ENV=production
APP_KEY=base64:SUBSTITUIR_PELO_INSTALLADOR
APP_DEBUG=false
APP_URL=https://pdf2ofx.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pdf2ofx
DB_USERNAME=pdf2ofx
DB_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

CONVERTER_BASE_URL=http://converter-api:8000
CONVERTER_API_KEY=SUBSTITUIR_POR_CHAVE_INTERNA_FORTE
CONVERTER_REQUEST_TIMEOUT=60
CONVERTER_DOWNLOAD_TIMEOUT=300
MAX_UPLOAD_KB=51200

PDF2OFX_ENV=production
PDF2OFX_API_KEY=SUBSTITUIR_POR_CHAVE_INTERNA_FORTE
PDF2OFX_REDIS_URL=redis://:SUBSTITUIR_POR_SENHA_FORTE@redis:6379/0
PDF2OFX_DATA_DIR=/data/jobs
PDF2OFX_MAX_FILE_SIZE=52428800
PDF2OFX_JOB_TTL_HOURS=24
PDF2OFX_OCR_ENABLED=true
PDF2OFX_OCR_LANGUAGE=por
PDF2OFX_MAX_PAGES=200
PDF2OFX_OCR_DPI=180
PDF2OFX_OCR_PSM=6
PDF2OFX_OCR_WORKERS=1
PDF2OFX_OCR_PAGE_TIMEOUT_SECONDS=180
PDF2OFX_CELERY_EAGER=false
PDF2OFX_CORS_ORIGINS=[]

WEB_HOST_PORT=8080
PDF2OFX_HEALTH_URL=http://127.0.0.1:8080/health
CONVERTER_WORKER_CONCURRENCY=2
CONVERTER_API_TMPFS_SIZE=1024m
CONVERTER_WORKER_TMPFS_SIZE=2048m
POSTGRES_SHM_SIZE=256m
BACKUP_RETENTION_DAYS=14
