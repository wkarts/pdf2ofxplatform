APP_NAME=PDF2OFX
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://pdf2ofx.codisplan.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pdf2ofx
DB_USERNAME=pdf2ofx
DB_PASSWORD=USE_A_LONG_RANDOM_PASSWORD

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=USE_A_LONG_RANDOM_PASSWORD
REDIS_PORT=6379

CONVERTER_BASE_URL=http://converter-api:8000
CONVERTER_API_KEY=USE_A_LONG_RANDOM_INTERNAL_KEY
CONVERTER_REQUEST_TIMEOUT=60
CONVERTER_DOWNLOAD_TIMEOUT=300
MAX_UPLOAD_KB=51200

PDF2OFX_ENV=production
PDF2OFX_API_KEY=USE_A_LONG_RANDOM_INTERNAL_KEY
PDF2OFX_REDIS_URL=redis://:USE_A_LONG_RANDOM_PASSWORD@redis:6379/0
PDF2OFX_DATA_DIR=/data/jobs
PDF2OFX_MAX_FILE_SIZE=52428800
PDF2OFX_JOB_TTL_HOURS=24
PDF2OFX_OCR_ENABLED=true
PDF2OFX_OCR_LANGUAGE=por
PDF2OFX_MAX_PAGES=200
PDF2OFX_OCR_DPI=180
PDF2OFX_OCR_PSM=6
PDF2OFX_OCR_WORKERS=1
PDF2OFX_OCR_PAGE_TIMEOUT_SECONDS=180
PDF2OFX_CELERY_EAGER=false
PDF2OFX_CORS_ORIGINS=[]
WEB_HOST_PORT=8080

GHCR_NAMESPACE=wkarts
APP_IMAGE=ghcr.io/wkarts/pdf2ofx-app:1.1.8
GATEWAY_IMAGE=ghcr.io/wkarts/pdf2ofx-gateway:1.1.8
CONVERTER_IMAGE=ghcr.io/wkarts/pdf2ofx-converter:1.1.8

# Imagens-base e serviços espelhados no GHCR (não publicar no Docker Hub)
PHP_BASE_IMAGE=ghcr.io/wkarts/pdf2ofx-base-php:8.4-fpm-alpine
COMPOSER_BASE_IMAGE=ghcr.io/wkarts/pdf2ofx-base-composer:2.8
REDIS_EXTENSION_VERSION=6.3.0
NGINX_BASE_IMAGE=ghcr.io/wkarts/pdf2ofx-base-nginx:1.28-alpine
PYTHON_BASE_IMAGE=ghcr.io/wkarts/pdf2ofx-base-python:3.13-slim-bookworm
REDIS_IMAGE=ghcr.io/wkarts/pdf2ofx-base-redis:8-alpine
POSTGRES_IMAGE=ghcr.io/wkarts/pdf2ofx-base-postgres:17-alpine
